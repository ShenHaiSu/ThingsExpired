# ===========================================
# ThingsExpired 后端服务配置示例
# ===========================================
# 复制此文件为 .env 并根据需要修改配置值
# cp .env.example .env
# ===========================================

# -------------------------------------------
# 应用配置
# -------------------------------------------

# 应用名称
APP_NAME=ThingsExpired

# 服务监听地址
# 生产环境建议保持 127.0.0.1 配合前置的caddy实现https解密，禁止暴露真实端口向外
# 开发环境可以使用 0.0.0.0 监听本地所有网卡
APP_HOST=0.0.0.0

# 服务监听端口
APP_PORT=8080

# 运行模式: debug | release
# debug 模式会输出更多调试信息
# release 模式适用于生产环境
APP_MODE=debug

# -------------------------------------------
# 数据库配置
# -------------------------------------------

# SQLite 数据库文件路径
# 可以使用相对路径或绝对路径
DB_PATH=./data/app.db

# -------------------------------------------
# JWT 配置
# -------------------------------------------

# JWT 签名密钥
# 生产环境请务必修改为随机生成的强密钥！
# 可使用命令生成: openssl rand -base64 32
JWT_SECRET=things-expired-secret-key-2024

# JWT Token 过期时间（小时）
JWT_EXPIRE_HOURS=24

# -------------------------------------------
# 会话配置
# -------------------------------------------

# 单个用户最大同时登录会话数
# 超过此数量后，最早的会话将被自动注销
SESSION_MAX_SESSIONS=3

# -------------------------------------------
# 过期任务配置
# -------------------------------------------

# 是否启用物品过期自动更新任务
EXPIRATION_ENABLED=true

# 过期检查任务执行间隔（秒）
# 默认 3600 秒 = 1 小时
EXPIRATION_INTERVAL_SEC=3600

# 每次批量处理的物品数量
EXPIRATION_BATCH_SIZE=100

# -------------------------------------------
# 日志配置
# -------------------------------------------

# 日志文件存储目录
LOG_PATH=./logs

# 日志级别: debug | info | warn | error
# debug: 最详细，适合开发调试
# info: 常规信息，适合生产环境
# warn: 仅警告和错误
# error: 仅错误信息
LOG_LEVEL=info

# 日志文件最大保留天数
LOG_MAX_FILES=7

# -------------------------------------------
# SPA 前端配置
# -------------------------------------------

# 是否启用 SPA 静态文件服务
# 设为 false 可禁用前端文件服务，仅提供 API
SPA_ENABLED=true

# 前端打包文件目录路径
# 默认为 ./frontend-dist
# 前端项目构建后将 dist 目录内容复制到此路径
SPA_DIST_PATH=./frontend-dist