<Window x:Class="ThingsExpired.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="ThingsExpired - 物品过期管理"
        Height="800"
        Width="1200"
        MinHeight="600"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Closing="OnWindowClosing">

    <Grid>
        <!-- WebView2 控件 -->
        <wv2:WebView2 Name="webView"
                      Source="about:blank"
                      DefaultBackgroundColor="Transparent"/>

        <!-- 系统托盘图标 -->
        <tb:TaskbarIcon x:Name="trayIcon"
                        ToolTipText="ThingsExpired - 物品过期管理"
                        TrayMouseDoubleClick="OnTrayIconDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="打开主窗口" Click="OnShowWindowClick"/>
                    <MenuItem Header="检查过期物品" Click="OnCheckExpiryClick"/>
                    <Separator/>
                    <MenuItem Header="退出" Click="OnExitClick"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>